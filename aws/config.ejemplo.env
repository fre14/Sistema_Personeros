# ══════════════════════════════════════════════════════════════════════
# Configuracion del despliegue en AWS. Copie este archivo a aws/config.env
# y ajuste lo que necesite. Todo es opcional: sin config.env se usan
# estos mismos valores.
# ══════════════════════════════════════════════════════════════════════

# Nombre de la pila de CloudFormation y region.
# us-east-1 (Virginia) es la mas barata; sa-east-1 (Sao Paulo) es la mas
# cercana a Peru pero cuesta ~40% mas. CloudFront sirve desde Lima igual.
STACK=electoral
REGION=us-east-1

# Correo para alarmas (servidores caidos, errores 5xx, base saturada) y
# avisos de presupuesto. AWS enviara un correo de confirmacion: acepte el enlace.
CORREO_ALERTAS=
PRESUPUESTO_USD=200

# Servidores de aplicacion (EC2 con autoescalado)
INSTANCIA_TIPO=t3.medium
MIN_INSTANCIAS=2          # siempre encendidos (uno por zona de disponibilidad)
MAX_INSTANCIAS=8          # tope del autoescalado
INSTANCIAS_PICO=4         # garantizados el 4 de octubre 06:00-10:30 y 15:00-01:00 (hora de Lima)
AGENDA_ELECCION=true

# Base de datos PostgreSQL 16 (RDS) y Redis (ElastiCache)
DB_CLASE=db.t4g.medium
DB_MULTI_AZ=true          # copia en espera en otra zona; conmutacion automatica
REDIS_TIPO=cache.t4g.small
REDIS_MULTI_AZ=true

# Dominio propio (opcional). Sin esto se usa https://dxxxx.cloudfront.net
# El certificado ACM debe estar emitido en us-east-1 para ese dominio.
DOMINIO=
CERTIFICADO_ACM=

# Duracion del token de acceso (cubre la jornada completa de un personero)
JWT_DURACION=12h
