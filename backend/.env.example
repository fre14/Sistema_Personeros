# ==========================================================================
# CONFIGURACION DEL BACKEND
# Copie este archivo a .env y reemplace TODOS los valores.
# NUNCA suba el archivo .env a GitHub.
# ==========================================================================

# ── Servidor ──
NODE_ENV=production
PORT=3000
INSTANCE_ID=backend-1

# Dominios autorizados a consumir la API, separados por coma.
# Debe incluir el dominio real del sistema (con https).
CORS_ORIGIN=https://elecciones.sudominio.com

# Saltos de proxy delante del backend (Nginx = 1, Nginx + Cloudflare = 2).
# Si este valor es incorrecto, el rate limit bloqueara a todos los usuarios juntos.
TRUST_PROXY_HOPS=1

# ── Base de datos PostgreSQL ──
# Con PgBouncer (recomendado): DB_HOST=pgbouncer y DB_PORT=6432
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=sistema_electoral
DB_USER=electoral_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_SSL=false

# Alternativa: cadena de conexion completa (tiene prioridad sobre lo anterior)
# DATABASE_URL=postgresql://usuario:password@host:5432/sistema_electoral

# Tamano del pool POR INSTANCIA de backend.
# Regla: DB_POOL_MAX x numero_de_backends <= max_connections de PostgreSQL.
# Con 4 backends y max_connections=300: 40 x 4 = 160, queda margen. OK.
DB_POOL_MIN=5
DB_POOL_MAX=40
DB_ACQUIRE_TIMEOUT=10000

# ── Redis (cache + sincronizacion de WebSocket entre instancias) ──
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
# REDIS_URL=redis://:password@redis:6379

# Segundos que se cachea el dashboard. Subirlo alivia la base de datos,
# bajarlo hace el tablero mas inmediato. 5 es un buen equilibrio.
CACHE_TTL_SECONDS=5

# ── JWT ──
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_CADENA_ALEATORIA_LARGA
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRA_CADENA_ALEATORIA_LARGA
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── Almacenamiento de fotos de actas ──
# Opcion A: local en disco del servidor (por defecto, sin dependencias externas)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads
# URL publica desde la que Nginx sirve las actas
STORAGE_PUBLIC_URL=/actas

# Opcion B: Supabase Storage. Cambie STORAGE_DRIVER=supabase y complete:
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=su_service_key
# SUPABASE_STORAGE_BUCKET=actas-electorales

# ── Limites de seguridad (peticiones por minuto y por IP) ──
RATE_LIMIT_AUTH=15
RATE_LIMIT_WRITE=30
RATE_LIMIT_API=300

# ── Reglas de negocio ──
MAX_VOTOS_POR_MESA=300
WS_MAX_SOCKETS_PER_USER=3
